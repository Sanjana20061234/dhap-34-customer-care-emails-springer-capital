# Airflow image and user
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5-python3.11
AIRFLOW_UID=50000

# Airflow web UI admin login
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change_me

# Airflow metadata database
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_DB_NAME=airflow

# Target database
TARGET_POSTGRES_USER=postgres
TARGET_POSTGRES_PASSWORD=change_me
TARGET_POSTGRES_DB=customer_care
TARGET_POSTGRES_PORT=5433

# Must match the target database values above
AIRFLOW_CONN_TARGET_POSTGRES=postgres://postgres:change_me@target-postgres:5432/customer_care
